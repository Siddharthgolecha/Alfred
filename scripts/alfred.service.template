# Alfred systemd user service for {{USER}}. Generated by install.sh from
# scripts/alfred.service.template.
#
# The --config flag is optional: Alfred runs on built-in defaults without it.
# To use a custom config, append "--config /path/to/config.json" to ExecStart.

[Unit]
Description=Alfred voice automation agent
After=network.target sound.target
Wants=sound.target

[Service]
Type=simple
WorkingDirectory={{INSTALL_DIR}}
ExecStart={{VENV_PYTHON}} -m alfred {{CONFIG}}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
